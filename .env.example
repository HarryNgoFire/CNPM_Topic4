# OSRM road-routing API (no commercial API key needed).
# Public demo server is best-effort, for small non-commercial/student projects.
# When running with self-hosted compose.maps.yaml, set OSRM_BASE_URL=http://osrm:5000
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_ROUTE_TIMEOUT_MS=6000
# Self-hosted Nominatim geocoding proxy (bounded to Vietnam, 5s timeout, 24h cache)
# When running with self-hosted compose.maps.yaml, set GEOCODER_BASE_URL=http://nominatim:8080
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_TIMEOUT_MS=5000
# Prioritize geocoding search results inside HCMC & adjacent provinces (minLon,maxLat,maxLon,minLat)
GEOCODER_VIEWBOX=105.8,11.4,107.4,10.3

DATABASE_URL=postgresql://topic4:topic4@localhost:5432/topic4
PORT=3001

# Email OTP verification via Gmail SMTP. Use a Google App Password, not your Gmail login password.
# Codes go to the recipient address entered at registration; SMTP_USER is the sending account.
EMAIL_DELIVERY_MODE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=youraccount@gmail.com
SMTP_APP_PASSWORD=your_16_character_google_app_password
EMAIL_FROM="MoveFlow <youraccount@gmail.com>"
OTP_SECRET=replace-with-random-secret-at-least-32-characters
JWT_SECRET=replace-with-random-secret-at-least-32-characters
JWT_ISSUER=topic4
JWT_AUDIENCE=topic4-api
CORS_ORIGIN=http://localhost:3000,http://localhost:3005
DISPATCH_RADIUS_M=10000
ASSIGNMENT_TIMEOUT_SECONDS=300
MAX_ASSIGNMENT_ATTEMPTS=5
MAX_LOCATION_AGE_SECONDS=300
# Explicit destination allowlist; leave empty to disable subscription creation.
WEBHOOK_ALLOWED_ORIGINS=http://receiver:4000
WEBHOOK_ALLOW_HTTP=true
POSTGRES_PASSWORD=change-to-a-local-database-password
DEMO_PASSWORD=admin
WEBHOOK_RECEIVER_SECRET=replace-with-random-receiver-secret-at-least-32-characters
