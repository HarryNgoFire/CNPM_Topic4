# OSRM road-routing API (no API key needed).
# Public demo server is best-effort, for small non-commercial/student projects.
# It uses the driving profile (not a dedicated motorbike profile); limit usage to <= 1 request/second.
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_ROUTE_TIMEOUT_MS=6000

# Google Maps URLs only open navigation in Google Maps and do not require an API key.
# TWO_WHEELER opens motorbike directions where supported.
GOOGLE_MAPS_TRAVEL_MODE=TWO_WHEELER

DATABASE_URL=postgresql://topic4:topic4@localhost:5432/topic4
PORT=3001

# Email OTP verification over SMTP (Gmail App Password), see docs/NODEMAILER_OSM_SETUP.md.
# Local testing without email: set EMAIL_DELIVERY_MODE=console and uncomment NODE_ENV below,
# then read the code with `docker compose logs api`. The Docker image runs with
# NODE_ENV=production, where console delivery is refused and registration fails with 503.
EMAIL_DELIVERY_MODE=smtp
# NODE_ENV=development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=youraccount@gmail.com
SMTP_APP_PASSWORD=your_16_character_google_app_password
EMAIL_FROM="MoveFlow <youraccount@gmail.com>"
OTP_SECRET=replace-with-random-secret-at-least-32-characters
JWT_SECRET=replace-with-random-secret-at-least-32-characters
JWT_ISSUER=topic4
JWT_AUDIENCE=topic4-api
CORS_ORIGIN=http://localhost:3000
# Reverse proxies in front of the API. Keep 0 when clients reach it directly;
# compose.yaml sets 1 for nginx.
TRUST_PROXY_HOPS=0
DISPATCH_RADIUS_M=10000
ASSIGNMENT_TIMEOUT_SECONDS=300
MAX_ASSIGNMENT_ATTEMPTS=5
MAX_LOCATION_AGE_SECONDS=300
# Explicit destination allowlist; leave empty to disable subscription creation.
WEBHOOK_ALLOWED_ORIGINS=http://receiver:4000
WEBHOOK_ALLOW_HTTP=true
POSTGRES_PASSWORD=change-to-a-local-database-password
DEMO_PASSWORD=change-to-a-demo-password
WEBHOOK_RECEIVER_SECRET=replace-with-random-receiver-secret-at-least-32-characters
