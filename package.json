{
  "name": "cnpm-topic4",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/api"
  ],
  "engines": {
    "node": ">=22.12 <26"
  },
  "scripts": {
    "build": "npm run build -w apps/api",
    "dev:api": "npm run dev -w apps/api",
    "start": "npm run start -w apps/api",
    "test": "npm run test -w apps/api",
    "test:baseline": "npm run test:baseline -w apps/api",
    "test:coverage": "npm run test:coverage -w apps/api",
    "test:integration": "npm run test:integration -w apps/api",
    "typecheck": "npm run typecheck -w apps/api",
    "lint": "eslint apps/api/src apps/api/test scripts",
    "format": "prettier --write apps/api prisma scripts docs/m2 package.json",
    "db:generate": "prisma generate",
    "db:migrate": "npm run db:check-history && prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "openapi": "ts-node --project apps/api/tsconfig.json scripts/export-openapi.ts",
    "db:check-history": "node scripts/check-migration-history.mjs",
    "sync:vendor": "node scripts/sync-web-vendor.mjs",
    "test:web": "node --test apps/web/test/*.test.mjs"
  },
  "dependencies": {
    "@nestjs/swagger": "11.4.7",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^17.0.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "eslint": "^9.0.0",
    "maplibre-gl": "4.7.1",
    "prettier": "^3.0.0",
    "prisma": "7.10.0",
    "tsx": "^4.20.0",
    "typescript-eslint": "^8.0.0"
  },
  "overrides": {
    "prisma": {
      "mysql2": "^3.24.0"
    },
    "@prisma/config": {
      "deepmerge-ts": "^8.0.0"
    },
    "js-yaml": "4.3.2"
  }
}
