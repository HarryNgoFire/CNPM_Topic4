{
  "name": "@topic4/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "node --watch -r ts-node/register src/main.ts",
    "start": "node dist/main.js",
    "test": "jest --runInBand --testPathIgnorePatterns=integration",
    "test:coverage": "jest --runInBand --coverage --testPathIgnorePatterns=integration",
    "test:integration": "jest --runInBand --config jest.integration.config.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/throttler": "^6.0.0",
    "bcryptjs": "^3.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "decimal.js": "^10.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "helmet": "^8.0.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "jest": "29.7.0",
    "ts-jest": "^29.4.0",
    "@types/jest": "^29.5.0",
    "@nestjs/testing": "^11.0.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "ts-node": "^10.9.2"
  }
}
