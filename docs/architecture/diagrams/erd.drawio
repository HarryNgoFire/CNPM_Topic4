        <mxCell id="e_shipment_rule" value="feeBreakdown lưu ruleId + ruleVersion&lt;br&gt;(snapshot, không có khóa ngoại)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endSize=8;startArrow=none;strokeColor=#d79b00;fontSize=10;fontColor=#8a5a00;labelBackgroundColor=#ffffff;exitX=0;exitY=0.9418;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_Shipment" target="t_PricingRule"><mxGeometry x="0.38" relative="1" as="geometry"><Array as="points"><mxPoint x="877" y="595"/><mxPoint x="877" y="761"/><mxPoint x="654" y="761"/></Array></mxGeometry></mxCell>
        <mxCell id="n_enums" value="&lt;b&gt;Kiểu enum&lt;/b&gt;&lt;br&gt;&lt;b&gt;Role&lt;/b&gt;: SENDER, DRIVER, DISPATCHER, ADMIN, SYSTEM&lt;br&gt;&lt;b&gt;ShipmentStatus&lt;/b&gt;: RECEIVED, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED&lt;br&gt;&lt;b&gt;ServiceType&lt;/b&gt;: STANDARD, EXPRESS&lt;br&gt;&lt;b&gt;DriverStatus&lt;/b&gt;: OFFLINE, AVAILABLE, BUSY&lt;br&gt;&lt;b&gt;AssignmentStatus&lt;/b&gt;: PENDING, ACCEPTED, REJECTED, EXPIRED, COMPLETED&lt;br&gt;&lt;b&gt;DeliveryStatus&lt;/b&gt;: PENDING, DELIVERED, FAILED" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f8f9fa;strokeColor=#b0b0b0;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="336" height="168" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n_constraints" value="&lt;b&gt;Ràng buộc viết tay trong migration&lt;/b&gt;&lt;br&gt;• DriverAssignment: tối đa một bản ghi PENDING/ACCEPTED cho mỗi shipmentId và cho mỗi driverId (partial unique index)&lt;br&gt;• WebhookDelivery: unique (eventId, subscriptionId)&lt;br&gt;• Shipment: trigger khóa fee và feeBreakdown; CHECK fee ≥ 0&lt;br&gt;• ShipmentStatusHistory: trigger chặn UPDATE/DELETE&lt;br&gt;• Parcel: CHECK khối lượng, kích thước &amp;gt; 0&lt;br&gt;• PricingRule: CHECK giá ≥ 0, hệ số &amp;gt; 0&lt;br&gt;• Driver.currentLocation: GiST index&lt;br&gt;• Mọi khóa ngoại: ON DELETE RESTRICT" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f8f9fa;strokeColor=#b0b0b0;" vertex="1" parent="1"><mxGeometry x="932" y="890" width="336" height="196" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n_legend" value="&lt;b&gt;Chú giải&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;strokeColor=#b0b0b0;" vertex="1" parent="1"><mxGeometry x="1378" y="80" width="336" height="172" as="geometry"></mxGeometry></mxCell>
