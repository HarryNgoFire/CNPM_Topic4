<mxfile host="app.diagrams.net" version="24.7.17">
  <diagram id="shipment-state-machine" name="Shipment state machine">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="520" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;State machine — vòng đời Shipment (chỉ chuyển tiến)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#1f3b5c;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"></mxGeometry></mxCell>
        <mxCell id="subtitle" value="Nguồn: canTransition() và ShipmentsService.transition() · BR-STATE-01, BR-STATE-02, BR-STATE-03" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1100" height="22" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s0" value='&lt;b style="font-size:13px"&gt;RECEIVED&lt;/b&gt;&lt;hr size="1"&gt;entry / thêm 1 dòng history&lt;br&gt;(fromStatus = null),&lt;br&gt;thêm 1 outbox event' style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacing=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="220" y="130" width="210" height="126" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s1" value='&lt;b style="font-size:13px"&gt;IN_TRANSIT&lt;/b&gt;&lt;hr size="1"&gt;entry / thêm 1 dòng history,&lt;br&gt;thêm 1 outbox event' style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacing=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="610" y="130" width="210" height="126" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s2" value='&lt;b style="font-size:13px"&gt;OUT_FOR_DELIVERY&lt;/b&gt;&lt;hr size="1"&gt;entry / thêm 1 dòng history,&lt;br&gt;thêm 1 outbox event' style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacing=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1000" y="130" width="210" height="126" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s3" value='&lt;b style="font-size:13px"&gt;DELIVERED&lt;/b&gt;&lt;hr size="1"&gt;entry / thêm 1 dòng history,&lt;br&gt;thêm 1 outbox event,&lt;br&gt;assignment → COMPLETED,&lt;br&gt;driver → AVAILABLE' style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacing=6;fontSize=11;fillColor=#e6e6e6;strokeColor=#7a7a7a;" vertex="1" parent="1"><mxGeometry x="1390" y="130" width="210" height="126" as="geometry"></mxGeometry></mxCell>
        <mxCell id="init" value="" style="ellipse;html=1;aspect=fixed;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="181" width="24" height="24" as="geometry"></mxGeometry></mxCell>
        <mxCell id="final" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1670" y="179" width="28" height="28" as="geometry"></mxGeometry></mxCell>
        <mxCell id="t_init" value="POST /shipments&lt;br&gt;[Sender | Admin]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1" source="init" target="s0"><mxGeometry relative="1" as="geometry"><mxPoint y="-8" as="offset"/></mxGeometry></mxCell>
        <mxCell id="t0" value="transition&lt;br&gt;toStatus = IN_TRANSIT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry"><mxPoint y="-8" as="offset"/></mxGeometry></mxCell>
        <mxCell id="t1" value="transition&lt;br&gt;toStatus = OUT_FOR_DELIVERY" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"><mxPoint y="-8" as="offset"/></mxGeometry></mxCell>
        <mxCell id="t2" value="transition&lt;br&gt;toStatus = DELIVERED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"><mxPoint y="-8" as="offset"/></mxGeometry></mxCell>
        <mxCell id="t_final" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1" source="s3" target="final"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n_guard" value="&lt;b&gt;Mọi lần chuyển trạng thái đi qua một điểm duy nhất: POST /api/v1/shipments/{id}/transition&lt;/b&gt;&lt;br&gt;Thứ tự kiểm tra trong ShipmentsService.transition(), tất cả nằm trong một transaction:&lt;br&gt;1. Khóa dòng Shipment bằng SELECT … FOR UPDATE; không tìm thấy → 404.&lt;br&gt;2. Actor phải là tài xế của assignment đã ACCEPTED của đơn, hoặc Admin; sai → 403.&lt;br&gt;3. toStatus trùng trạng thái hiện tại → 200 (idempotent), không ghi thêm history hay event.&lt;br&gt;4. canTransition(current, next) chỉ cho tiến đúng một bước; sai → 409.&lt;br&gt;5. Đơn phải có assignment ACCEPTED, kể cả khi actor là Admin; thiếu → 409.&lt;br&gt;6. Cập nhật status, thêm một dòng ShipmentStatusHistory và một WebhookEvent (outbox). Một bước lỗi thì rollback toàn bộ." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f8f9fa;strokeColor=#b0b0b0;" vertex="1" parent="1"><mxGeometry x="220" y="320" width="820" height="150" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n_reject" value="&lt;b&gt;Bị từ chối với 409 Conflict&lt;/b&gt;&lt;br&gt;• Nhảy bước: RECEIVED → OUT_FOR_DELIVERY, RECEIVED → DELIVERED, IN_TRANSIT → DELIVERED&lt;br&gt;• Đi lùi: IN_TRANSIT → RECEIVED, DELIVERED → OUT_FOR_DELIVERY, …&lt;br&gt;• Rời trạng thái cuối: DELIVERED → bất kỳ trạng thái khác&lt;br&gt;&lt;br&gt;&lt;b&gt;Không đổi trạng thái Shipment&lt;/b&gt;&lt;br&gt;• Tài xế ACCEPT lời mời: đơn vẫn RECEIVED cho tới khi tài xế gọi transition&lt;br&gt;• Tài xế REJECT hoặc lời mời hết hạn: hệ thống tìm tài xế khác" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#fff5f5;strokeColor=#c98a8a;" vertex="1" parent="1"><mxGeometry x="1070" y="320" width="530" height="150" as="geometry"></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
