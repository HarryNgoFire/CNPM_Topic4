        <mxCell id="title" value="&lt;b&gt;State machine — vòng đời Shipment (giao hai chặng)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#1f3b5c;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="30" as="geometry"></mxGeometry></mxCell>
        <mxCell id="subtitle" value="Nguồn: VALID_TRANSITIONS / canTransition() trong apps/api/src/modules/shipments/state-machine.ts, ShipmentsService.transition(), DispatchService.respond() · migration 20261110020000_two_stage_delivery_state · BR-STATE-01..03" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1600" height="22" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c_active" value="Đơn chưa kết thúc" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=12;fontStyle=1;fillColor=#fcfcfc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="170" y="90" width="1520" height="420" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c_stage1" value="Chặng 1 — tới điểm lấy hàng A" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fontStyle=1;fillColor=#f0f6ff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="460" y="140" width="540" height="220" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c_stage2" value="Chặng 2 — tới điểm giao B" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fontStyle=1;fillColor=#f0f6ff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1080" y="140" width="580" height="350" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s_received" value="&lt;b style=&quot;font-size:13px&quot;&gt;RECEIVED&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;Đơn đã tạo, chờ tài xế nhận&lt;br&gt;entry / history (fromStatus = null), outbox event, mời tài xế gần nhất" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacing=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="200" y="200" width="180" height="120" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s_en_route_pickup" value="&lt;b style=&quot;font-size:13px&quot;&gt;EN_ROUTE_PICKUP&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;Tài xế đã nhận đơn, đang tới A&lt;br&gt;entry / history, outbox event" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacing=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="500" y="200" width="180" height="120" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s_arrived_pickup" value="&lt;b style=&quot;font-size:13px&quot;&gt;ARRIVED_PICKUP&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;Tài xế đã ở điểm A&lt;br&gt;entry / history, outbox event" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacing=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="800" y="200" width="180" height="120" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s_out_for_delivery" value="&lt;b style=&quot;font-size:13px&quot;&gt;OUT_FOR_DELIVERY&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;Đã lấy hàng, đang tới B&lt;br&gt;entry / history, outbox event" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacing=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1120" y="200" width="180" height="120" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s_arrived_dropoff" value="&lt;b style=&quot;font-size:13px&quot;&gt;ARRIVED_DROPOFF&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;Tài xế đã ở điểm B&lt;br&gt;entry / history, outbox event" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacing=6;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1440" y="200" width="180" height="120" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s_in_transit" value="&lt;b style=&quot;font-size:13px&quot;&gt;IN_TRANSIT&lt;/b&gt; (cũ)&lt;hr size=&quot;1&quot;&gt;Chỉ còn ở đơn tạo trước migration 20261110020000; không transition nào đi vào" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacing=6;fontSize=11;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1120" y="380" width="180" height="96" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s_delivered" value="&lt;b style=&quot;font-size:13px&quot;&gt;DELIVERED&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;entry / history, outbox event, assignment → COMPLETED, tài xế → AVAILABLE" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacing=6;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1840" y="200" width="200" height="120" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s_delivery_failed" value="&lt;b style=&quot;font-size:13px&quot;&gt;DELIVERY_FAILED&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;entry / lưu reason, history, outbox event, giải phóng tài xế" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacing=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1840" y="390" width="200" height="110" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s_cancelled" value="&lt;b style=&quot;font-size:13px&quot;&gt;CANCELLED&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;entry / lưu reason, history, outbox event, giải phóng tài xế nếu có" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacing=6;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1840" y="580" width="200" height="110" as="geometry"></mxGeometry></mxCell>
        <mxCell id="init" value="" style="ellipse;html=1;aspect=fixed;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="248" width="24" height="24" as="geometry"></mxGeometry></mxCell>
        <mxCell id="final_delivered" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="2100" y="246" width="28" height="28" as="geometry"></mxGeometry></mxCell>
        <mxCell id="final_failed" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="2100" y="431" width="28" height="28" as="geometry"></mxGeometry></mxCell>
        <mxCell id="final_cancelled" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="2100" y="621" width="28" height="28" as="geometry"></mxGeometry></mxCell>
        <mxCell id="t_create" value="POST /shipments&lt;br&gt;[Sender | Admin]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1" source="init" target="s_received"><mxGeometry relative="1" as="geometry"><mxPoint y="-8" as="offset"/></mxGeometry></mxCell>
        <mxCell id="t_accept" value="tài xế ACCEPT lời mời&lt;br&gt;[tài xế AVAILABLE]&lt;br&gt;/ tài xế → BUSY" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1" source="s_received" target="s_en_route_pickup"><mxGeometry relative="1" as="geometry"><mxPoint y="-8" as="offset"/></mxGeometry></mxCell>
        <mxCell id="t_arrive_a" value="báo đã tới A&lt;br&gt;[geofence ≤ 100 m]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1" source="s_en_route_pickup" target="s_arrived_pickup"><mxGeometry relative="1" as="geometry"><mxPoint y="-8" as="offset"/></mxGeometry></mxCell>
        <mxCell id="t_pickup" value="xác nhận&lt;br&gt;đã lấy hàng" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1" source="s_arrived_pickup" target="s_out_for_delivery"><mxGeometry relative="1" as="geometry"><mxPoint y="-8" as="offset"/></mxGeometry></mxCell>
        <mxCell id="t_arrive_b" value="báo đã tới B&lt;br&gt;[geofence ≤ 100 m]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1" source="s_out_for_delivery" target="s_arrived_dropoff"><mxGeometry relative="1" as="geometry"><mxPoint y="-8" as="offset"/></mxGeometry></mxCell>
        <mxCell id="t_deliver" value="xác nhận đã giao" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1" source="s_arrived_dropoff" target="s_delivered"><mxGeometry relative="1" as="geometry"><mxPoint y="-8" as="offset"/></mxGeometry></mxCell>
        <mxCell id="t_legacy" value="tiếp tục giao" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#777777;fontSize=10;labelBackgroundColor=#ffffff;align=left;spacingLeft=6;" edge="1" parent="1" source="s_in_transit" target="s_out_for_delivery"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="t_failed" value="báo giao thất bại&lt;br&gt;[Tài xế | Admin, có reason]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#b85450;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;exitX=1;exitY=0.8714;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_stage2" target="s_delivery_failed"><mxGeometry relative="1" as="geometry"><mxPoint y="-8" as="offset"/></mxGeometry></mxCell>
        <mxCell id="t_cancel" value="hủy đơn [có reason]&lt;br&gt;Sender: đơn của mình, còn RECEIVED và chưa có tài xế ACCEPTED&lt;br&gt;Admin: ở bất kỳ trạng thái chưa kết thúc nào" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#b85450;fontSize=10;labelBackgroundColor=#ffffff;align=left;exitX=0.5461;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c_active" target="s_cancelled"><mxGeometry x="0.1" relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="635"/></Array><mxPoint x="-150" y="-26" as="offset"/></mxGeometry></mxCell>
        <mxCell id="t_end_delivered" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#333333;" edge="1" parent="1" source="s_delivered" target="final_delivered"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="t_end_failed" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#333333;" edge="1" parent="1" source="s_delivery_failed" target="final_failed"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="t_end_cancelled" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#333333;" edge="1" parent="1" source="s_cancelled" target="final_cancelled"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n_guard" value="&lt;b&gt;Mọi lần chuyển trạng thái, trừ RECEIVED → EN_ROUTE_PICKUP, đi qua POST /api/v1/shipments/{id}/transition&lt;/b&gt;&lt;br&gt;Thứ tự kiểm tra trong ShipmentsService.transition(), tất cả nằm trong một transaction:&lt;br&gt;1. Khóa dòng Shipment bằng SELECT … FOR UPDATE; không tìm thấy → 404.&lt;br&gt;2. toStatus trùng trạng thái hiện tại → 200 idempotent (vẫn kiểm tra quyền sở hữu), không ghi thêm history hay event.&lt;br&gt;3. Kiểm tra vai trò → 403 hoặc 409: Sender chỉ được hủy đơn của mình; Tài xế phải giữ assignment ACCEPTED của đơn và không được hủy; Admin cần assignment ACCEPTED, trừ khi hủy; Dispatcher bị guard chặn.&lt;br&gt;4. canTransition(current, next) tra bảng VALID_TRANSITIONS; cặp không có trong bảng → 409.&lt;br&gt;5. Tài xế báo ARRIVED_PICKUP / ARRIVED_DROPOFF: vị trí ghi không quá 30 giây, độ chính xác ≤ 50 m, cách đích ≤ 100 m; sai → 409. Admin không bị kiểm tra geofence.&lt;br&gt;6. reason bắt buộc (1–255 ký tự) với CANCELLED, DELIVERY_FAILED và bị cấm với trạng thái khác; sai → 400.&lt;br&gt;7. Cập nhật status, thêm một dòng ShipmentStatusHistory và một WebhookEvent (outbox). Một bước lỗi thì rollback toàn bộ.&lt;br&gt;&lt;br&gt;RECEIVED → EN_ROUTE_PICKUP do DispatchService.respond(ACCEPT) thực hiện khi tài xế nhận lời mời (POST /assignments/{id}/respond), cũng ghi history và event trong cùng transaction." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f8f9fa;strokeColor=#b0b0b0;" vertex="1" parent="1"><mxGeometry x="170" y="730" width="1000" height="200" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n_reject" value="&lt;b&gt;canTransition() chặn với 409 Conflict&lt;/b&gt;&lt;br&gt;• Nhảy bước: EN_ROUTE_PICKUP → OUT_FOR_DELIVERY, OUT_FOR_DELIVERY → DELIVERED, …&lt;br&gt;• Đi lùi: ARRIVED_PICKUP → EN_ROUTE_PICKUP, OUT_FOR_DELIVERY → ARRIVED_PICKUP, …&lt;br&gt;• Rời trạng thái cuối: DELIVERED, CANCELLED, DELIVERY_FAILED → bất kỳ&lt;br&gt;• Đi vào IN_TRANSIT từ bất kỳ trạng thái nào&lt;br&gt;• DELIVERY_FAILED khi chưa lấy hàng (RECEIVED, EN_ROUTE_PICKUP, ARRIVED_PICKUP)&lt;br&gt;&lt;br&gt;&lt;b&gt;Không đổi trạng thái Shipment&lt;/b&gt;&lt;br&gt;• Tài xế REJECT hoặc lời mời hết hạn: đơn vẫn RECEIVED, hệ thống mời tài xế kế tiếp&lt;br&gt;&lt;br&gt;&lt;b&gt;Khi vào trạng thái cuối&lt;/b&gt; (DELIVERED, CANCELLED, DELIVERY_FAILED): assignment PENDING/ACCEPTED → COMPLETED, tài xế → AVAILABLE" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#fff5f5;strokeColor=#c98a8a;" vertex="1" parent="1"><mxGeometry x="1200" y="730" width="840" height="200" as="geometry"></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
