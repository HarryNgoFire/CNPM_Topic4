        <mxCell id="subtitle" value="Nguồn chuẩn: VALID_TRANSITIONS và ShipmentsService.transition() · migrations hiện tại" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1100" height="22" as="geometry"></mxGeometry></mxCell>
        <mxCell id="init" value="" style="ellipse;html=1;aspect=fixed;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="25" y="168" width="24" height="24" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s_received" value="&lt;b&gt;RECEIVED&lt;/b&gt;&lt;br&gt;Đơn mới; chờ tài xế" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="130" width="190" height="100" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s_enroute_pickup" value="&lt;b&gt;EN_ROUTE_PICKUP&lt;/b&gt;&lt;br&gt;Tài xế đã nhận đơn" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="340" y="130" width="190" height="100" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s_arrived_pickup" value="&lt;b&gt;ARRIVED_PICKUP&lt;/b&gt;&lt;br&gt;GPS trong geofence điểm lấy" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="600" y="130" width="190" height="100" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s_out_for_delivery" value="&lt;b&gt;OUT_FOR_DELIVERY&lt;/b&gt;&lt;br&gt;Đã nhận hàng, đi giao" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="860" y="130" width="190" height="100" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s_arrived_dropoff" value="&lt;b&gt;ARRIVED_DROPOFF&lt;/b&gt;&lt;br&gt;GPS trong geofence điểm giao" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1120" y="130" width="190" height="100" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s_delivered" value="&lt;b&gt;DELIVERED&lt;/b&gt;&lt;br&gt;Hoàn tất" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1380" y="130" width="190" height="100" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s_in_transit" value="&lt;b&gt;IN_TRANSIT&lt;/b&gt;&lt;br&gt;Trạng thái tương thích; chuyển tiếp tới OUT_FOR_DELIVERY" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="600" y="300" width="230" height="90" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s_failed" value="&lt;b&gt;DELIVERY_FAILED&lt;/b&gt;&lt;br&gt;Kết thúc với lý do" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1050" y="300" width="210" height="90" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s_cancelled" value="&lt;b&gt;CANCELLED&lt;/b&gt;&lt;br&gt;Kết thúc với lý do" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1330" y="300" width="210" height="90" as="geometry"></mxGeometry></mxCell>
        <mxCell id="t_init" value="Tạo shipment" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="init" target="s_received"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="t_received" value="Tài xế ACCEPT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="s_received" target="s_enroute_pickup"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="t_pickup" value="Geofence hợp lệ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="s_enroute_pickup" target="s_arrived_pickup"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="t_loaded" value="Xác nhận đã nhận hàng" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="s_arrived_pickup" target="s_out_for_delivery"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="t_dropoff" value="Geofence hợp lệ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="s_out_for_delivery" target="s_arrived_dropoff"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="t_delivered" value="Xác nhận giao thành công" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="s_arrived_dropoff" target="s_delivered"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="t_compat" value="IN_TRANSIT → OUT_FOR_DELIVERY" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#d6b656;fontSize=10;" edge="1" parent="1" source="s_in_transit" target="s_out_for_delivery"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="t_failed1" value="Báo thất bại + lý do" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="s_out_for_delivery" target="s_failed"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="t_failed2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="s_arrived_dropoff" target="s_failed"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="t_failed3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="s_in_transit" target="s_failed"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="t_cancel" value="Hủy theo quyền + lý do" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endSize=10;strokeColor=#b85450;fontSize=10;" edge="1" parent="1" source="s_received" target="s_cancelled"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="n_rules" value="&lt;b&gt;Điều kiện áp dụng&lt;/b&gt;&lt;br&gt;• Chỉ các chuyển trạng thái được service cho phép; chuyển sai trả 409.&lt;br&gt;• ARRIVED_PICKUP / ARRIVED_DROPOFF cần GPS mới, đủ chính xác và trong bán kính 100 m.&lt;br&gt;• SENDER chỉ được hủy shipment của mình khi còn RECEIVED và chưa có assignment được chấp nhận. ADMIN có thể hủy theo quyền.&lt;br&gt;• DELIVERY_FAILED và CANCELLED yêu cầu lý do. Mỗi chuyển trạng thái hợp lệ ghi history và outbox event trong transaction.&lt;br&gt;• IN_TRANSIT là nhánh tương thích, không phải trạng thái chuẩn của luồng giao hai chặng." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#f8f9fa;strokeColor=#b0b0b0;" vertex="1" parent="1"><mxGeometry x="80" y="470" width="1480" height="180" as="geometry"></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
